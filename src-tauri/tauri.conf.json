{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moviary",
  "version": "1.7.5",
  "identifier": "cz.filmoteka.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Moviary",
        "width": 1320,
        "height": 840,
        "minWidth": 860,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
